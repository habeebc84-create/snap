# SecureDoc AI — non-secret configuration only. No API keys are required.
# Copy to `.env` (optional): every value below is already the default.
APP_ENV=development
DATABASE_URL=sqlite:///./data/securedoc.db
DOCUMENT_STORAGE_PATH=./data/documents
PROCESSED_PATH=./data/processed
EXPORTS_PATH=./data/exports
MODEL_PATH=./models
OCR_LANG=eng
CONFIDENCE_THRESHOLD=0.75
MAX_UPLOAD_MB=25
CLOUD_PROCESSING=false
TELEMETRY=false
API_PORT=8000
